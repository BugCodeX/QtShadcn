/* QtShadcn base stylesheet generated from a native QtShadcn XML theme. */

* {
    color: {{ tokens.foreground }};
    font-family: {{ tokens.font_family }};
    font-size: {{ scale.TEXT_BASE }};
}

QWidget {
    background-color: {{ tokens.background }};
    color: {{ tokens.foreground }};
}

/* ============================================================
   QPushButton - QtShadcn
   ============================================================ */

QPushButton {
    background-color: {{ tokens.primary }};
    color: {{ tokens.primary_foreground }};
    border: 1px solid transparent;
    outline: none;
    border-radius: {{ radius.class_px(tokens.radius, "lg") }};
    padding-left: {{ scale.spacing_px(tokens.spacing, 2.5) }};
    padding-right: {{ scale.spacing_px(tokens.spacing, 2.5) }};
    min-height: {{ scale.spacing_px(tokens.spacing, 8) }};
    font-size: {{ scale.TEXT_SM }};
    font-weight: {{ scale.FONT_WEIGHT_MEDIUM }};
}

QPushButton:hover {
    background-color: {{ colors.alpha(tokens.primary, 0.8) }};
}

QPushButton:pressed {
    background-color: {{ tokens.secondary }};
    color: {{ tokens.secondary_foreground }};
}

QPushButton:focus {
    background-color: {{ tokens.primary }};
    color: {{ tokens.primary_foreground }};
    border-color: {{ colors.alpha(tokens.ring, 0.5) }};
    outline: none;
}

QPushButton:disabled {
    background-color: {{ colors.alpha(tokens.primary, 0.5) }};
    color: {{ colors.alpha(tokens.primary_foreground, 0.5) }};
    border-color: transparent;
}

QPushButton[invalid="true"]:focus {
    border-color: {{ tokens.destructive }};
    color: {{ tokens.destructive }};
}

QPushButton[variant="default"] {
    background-color: {{ tokens.primary }};
    color: {{ tokens.primary_foreground }};
    border-color: transparent;
}

QPushButton[variant="default"]:focus {
    background-color: {{ tokens.primary }};
    color: {{ tokens.primary_foreground }};
    border-color: {{ colors.alpha(tokens.ring, 0.5) }};
}

QPushButton[variant="default"]:hover,
QPushButton[variant="default"]:pressed {
    background-color: {{ colors.alpha(tokens.primary, 0.8) }};
}

QPushButton[variant="outline"] {
    background-color: {{ tokens.background }};
    color: {{ tokens.foreground }};
    border-color: {{ tokens.border }};
}

QPushButton[variant="outline"]:hover,
QPushButton[variant="outline"]:pressed {
    background-color: {{ tokens.muted }};
    color: {{ tokens.foreground }};
}

QPushButton[variant="secondary"] {
    background-color: {{ tokens.secondary }};
    color: {{ tokens.secondary_foreground }};
    border-color: transparent;
}

QPushButton[variant="secondary"]:hover,
QPushButton[variant="secondary"]:pressed {
    background-color: {{ colors.mix(tokens.secondary, tokens.foreground, 0.05) }};
    color: {{ tokens.secondary_foreground }};
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    color: {{ tokens.foreground }};
    border-color: transparent;
}

QPushButton[variant="ghost"]:hover,
QPushButton[variant="ghost"]:pressed {
    background-color: {{ tokens.muted }};
    color: {{ tokens.foreground }};
}

QPushButton[variant="destructive"] {
    background-color: {{ colors.alpha(tokens.destructive, 0.1) }};
    color: {{ tokens.destructive }};
    border-color: transparent;
}

QPushButton[variant="destructive"]:hover,
QPushButton[variant="destructive"]:pressed {
    background-color: {{ colors.alpha(tokens.destructive, 0.2) }};
}

QPushButton[variant="link"] {
    background-color: transparent;
    color: {{ tokens.primary }};
    border-color: transparent;
    padding-left: 0px;
    padding-right: 0px;
    text-decoration: underline;
}

QPushButton[variant="link"]:hover,
QPushButton[variant="link"]:pressed {
    background-color: transparent;
    color: {{ tokens.primary }};
    text-decoration: underline;
}

QPushButton[variant="outline"]:disabled {
    background-color: transparent;
    color: {{ colors.alpha(tokens.foreground, 0.5) }};
    border-color: {{ tokens.border }};
}

QPushButton[variant="ghost"]:disabled,
QPushButton[variant="link"]:disabled {
    border: none;
    background-color: transparent;
    color: {{ colors.alpha(tokens.foreground, 0.5) }};
}

QPushButton[size="default"] {
    padding-left: {{ scale.spacing_px(tokens.spacing, 2.5) }};
    padding-right: {{ scale.spacing_px(tokens.spacing, 2.5) }};
    min-height: {{ scale.spacing_px(tokens.spacing, 8) }};
    font-size: {{ scale.TEXT_SM }};
}

QPushButton[size="default"][iconPosition="start"] {
    padding-left: {{ scale.spacing_px(tokens.spacing, 2) }};
}

QPushButton[size="default"][iconPosition="end"] {
    padding-right: {{ scale.spacing_px(tokens.spacing, 2) }};
}

QPushButton[size="xs"] {
    border-radius: {{ radius.min_px(tokens.radius, "md", "10px") }};
    padding-left: {{ scale.spacing_px(tokens.spacing, 2) }};
    padding-right: {{ scale.spacing_px(tokens.spacing, 2) }};
    min-height: {{ scale.spacing_px(tokens.spacing, 6) }};
    font-size: {{ scale.TEXT_XS }};
}

QPushButton[size="sm"] {
    border-radius: {{ radius.min_px(tokens.radius, "md", "12px") }};
    min-height: {{ scale.spacing_px(tokens.spacing, 7) }};
    font-size: 13px;
}

QPushButton[size="lg"] {
    min-height: {{ scale.spacing_px(tokens.spacing, 9) }};
    font-size: {{ scale.TEXT_SM }};
}

QPushButton[size="icon"],
QToolButton[size="icon"] {
    min-width: {{ scale.spacing_px(tokens.spacing, 8) }};
    max-width: {{ scale.spacing_px(tokens.spacing, 8) }};
    min-height: {{ scale.spacing_px(tokens.spacing, 8) }};
    max-height: {{ scale.spacing_px(tokens.spacing, 8) }};
}

QPushButton[size="icon-xs"] {
    border-radius: {{ radius.min_px(tokens.radius, "md", "10px") }};
    padding-left: {{ scale.spacing_px(tokens.spacing, 2) }};
    padding-right: {{ scale.spacing_px(tokens.spacing, 2) }};
    min-width: {{ scale.spacing_px(tokens.spacing, 6) }};
    max-width: {{ scale.spacing_px(tokens.spacing, 6) }};
    min-height: {{ scale.spacing_px(tokens.spacing, 6) }};
    max-height: {{ scale.spacing_px(tokens.spacing, 6) }};
    font-size: {{ scale.TEXT_XS }};
}

QPushButton[size="icon-sm"],
QToolButton[size="icon-sm"] {
    border-radius: {{ radius.min_px(tokens.radius, "md", "12px") }};
    min-width: {{ scale.spacing_px(tokens.spacing, 7) }};
    max-width: {{ scale.spacing_px(tokens.spacing, 7) }};
    min-height: {{ scale.spacing_px(tokens.spacing, 7) }};
    max-height: {{ scale.spacing_px(tokens.spacing, 7) }};
}

QPushButton[size="icon-lg"],
QToolButton[size="icon-lg"] {
    min-width: {{ scale.spacing_px(tokens.spacing, 9) }};
    max-width: {{ scale.spacing_px(tokens.spacing, 9) }};
    min-height: {{ scale.spacing_px(tokens.spacing, 9) }};
    max-height: {{ scale.spacing_px(tokens.spacing, 9) }};
    font-size: {{ scale.TEXT_SM }};
}

/* ============================================================
   QToolButton - QtShadcn
   ============================================================ */

QToolButton {
    background-color: {{ tokens.primary }};
    color: {{ tokens.primary_foreground }};
    border: 1px solid transparent;
    outline: none;
    border-radius: {{ radius.class_px(tokens.radius, "lg") }};
    padding: 0px;
    min-width: {{ scale.spacing_px(tokens.spacing, 8) }};
    max-width: {{ scale.spacing_px(tokens.spacing, 8) }};
    min-height: {{ scale.spacing_px(tokens.spacing, 8) }};
    max-height: {{ scale.spacing_px(tokens.spacing, 8) }};
    font-size: {{ scale.TEXT_SM }};
    font-weight: {{ scale.FONT_WEIGHT_MEDIUM }};
}

QToolButton:hover {
    background-color: {{ colors.alpha(tokens.primary, 0.8) }};
}

QToolButton:pressed,
QToolButton:checked {
    background-color: {{ colors.alpha(tokens.primary, 0.8) }};
    color: {{ tokens.primary_foreground }};
}

QToolButton:focus {
    background-color: {{ tokens.primary }};
    color: {{ tokens.primary_foreground }};
    border-color: {{ colors.alpha(tokens.ring, 0.5) }};
    outline: none;
}

QToolButton:disabled {
    background-color: {{ colors.alpha(tokens.primary, 0.5) }};
    color: {{ colors.alpha(tokens.primary_foreground, 0.5) }};
    border-color: transparent;
}

QToolButton[variant="default"] {
    background-color: {{ tokens.primary }};
    color: {{ tokens.primary_foreground }};
    border-color: transparent;
}

QToolButton[variant="default"]:focus {
    background-color: {{ tokens.primary }};
    color: {{ tokens.primary_foreground }};
    border-color: {{ colors.alpha(tokens.ring, 0.5) }};
}

QToolButton[variant="default"]:hover,
QToolButton[variant="default"]:pressed,
QToolButton[variant="default"]:checked {
    background-color: {{ colors.alpha(tokens.primary, 0.8) }};
    color: {{ tokens.primary_foreground }};
}

QToolButton[variant="outline"] {
    background-color: {{ tokens.background }};
    color: {{ tokens.foreground }};
    border-color: {{ tokens.border }};
}

QToolButton[variant="outline"]:focus {
    background-color: {{ tokens.background }};
    color: {{ tokens.foreground }};
    border-color: {{ colors.alpha(tokens.ring, 0.5) }};
}

QToolButton[variant="outline"]:hover,
QToolButton[variant="outline"]:pressed,
QToolButton[variant="outline"]:checked {
    background-color: {{ tokens.muted }};
    color: {{ tokens.foreground }};
}

QToolButton[variant="secondary"] {
    background-color: {{ tokens.secondary }};
    color: {{ tokens.secondary_foreground }};
    border-color: transparent;
}

QToolButton[variant="secondary"]:focus {
    background-color: {{ tokens.secondary }};
    color: {{ tokens.secondary_foreground }};
    border-color: {{ colors.alpha(tokens.ring, 0.5) }};
}

QToolButton[variant="secondary"]:hover,
QToolButton[variant="secondary"]:pressed,
QToolButton[variant="secondary"]:checked {
    background-color: {{ colors.mix(tokens.secondary, tokens.foreground, 0.05) }};
    color: {{ tokens.secondary_foreground }};
}

QToolButton[variant="ghost"] {
    background-color: transparent;
    color: {{ tokens.foreground }};
    border-color: transparent;
}

QToolButton[variant="ghost"]:focus {
    background-color: transparent;
    color: {{ tokens.foreground }};
    border-color: {{ colors.alpha(tokens.ring, 0.5) }};
}

QToolButton[variant="ghost"]:hover,
QToolButton[variant="ghost"]:pressed,
QToolButton[variant="ghost"]:checked {
    background-color: {{ tokens.muted }};
    color: {{ tokens.foreground }};
}

QToolButton[variant="destructive"] {
    background-color: {{ colors.alpha(tokens.destructive, 0.1) }};
    color: {{ tokens.destructive }};
    border-color: transparent;
}

QToolButton[variant="destructive"]:focus {
    background-color: {{ colors.alpha(tokens.destructive, 0.1) }};
    color: {{ tokens.destructive }};
    border-color: {{ colors.alpha(tokens.ring, 0.5) }};
}

QToolButton[variant="destructive"]:hover,
QToolButton[variant="destructive"]:pressed,
QToolButton[variant="destructive"]:checked {
    background-color: {{ colors.alpha(tokens.destructive, 0.2) }};
    color: {{ tokens.destructive }};
}

QToolButton[variant="outline"]:disabled {
    background-color: transparent;
    color: {{ colors.alpha(tokens.foreground, 0.5) }};
    border-color: {{ tokens.border }};
}

QToolButton[variant="default"]:disabled {
    background-color: {{ colors.alpha(tokens.primary, 0.5) }};
    color: {{ colors.alpha(tokens.primary_foreground, 0.5) }};
    border-color: transparent;
}

QToolButton[variant="secondary"]:disabled {
    background-color: {{ colors.alpha(tokens.secondary, 0.5) }};
    color: {{ colors.alpha(tokens.secondary_foreground, 0.5) }};
    border-color: transparent;
}

QToolButton[variant="ghost"]:disabled {
    border: none;
    background-color: transparent;
    color: {{ colors.alpha(tokens.foreground, 0.5) }};
}

QToolButton[variant="destructive"]:disabled {
    background-color: {{ colors.alpha(tokens.destructive, 0.1) }};
    color: {{ colors.alpha(tokens.destructive, 0.5) }};
    border-color: transparent;
}

/* ============================================================
   LineEdit - QtShadcn
   ============================================================ */

QLineEdit {
    background-color: {{ colors.alpha(tokens.input, 0.3) if is_dark else "transparent" }};
    color: {{ tokens.foreground }};
    border: 1px solid {{ tokens.input }};
    outline: none;
    border-radius: {{ radius.class_px(tokens.radius, "lg") }};
    padding-left: {{ scale.spacing_px(tokens.spacing, 2.5) }};
    padding-right: {{ scale.spacing_px(tokens.spacing, 2.5) }};
    min-width: {{ scale.spacing_px(tokens.spacing, 0) }};
    min-height: {{ scale.spacing_px(tokens.spacing, 8) }};
    font-size: {{ scale.TEXT_SM }};
    placeholder-text-color: {{ tokens.muted_foreground }};
    selection-background-color: {{ tokens.primary }};
    selection-color: {{ tokens.primary_foreground }};
}

QLineEdit:focus {
    border-color: {{ colors.alpha(tokens.ring, 0.5) }};
    outline: none;
}

QLineEdit:disabled {
    background-color: {{ tokens.muted }};
    color: {{ colors.alpha(tokens.muted_foreground, 0.5) }};
    border-color: {{ colors.alpha(tokens.input, 0.5) }};
    placeholder-text-color: {{ colors.alpha(tokens.muted_foreground, 0.5) }};
}

QLineEdit[invalid="true"] {
    border-color: {{ tokens.destructive }};
}

QLineEdit[invalid="true"]:focus {
    border-color: {{ colors.alpha(tokens.destructive, 0.5) }};
}

/* Typography classes */
*[class~="h1"] { font-size: 36px; font-weight: 700; }
*[class~="h2"] { font-size: 30px; font-weight: 600; }
*[class~="h3"] { font-size: 24px; font-weight: 600; }
*[class~="h4"] { font-size: 20px; font-weight: 600; }
*[class~="p"] { font-size: 16px; font-weight: 400; }
*[class~="small"] { font-size: 14px; font-weight: 400; }
*[class~="muted"] { color: {{ tokens.muted_foreground }}; }
