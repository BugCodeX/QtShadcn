  min-height: {{ Scale.resolveSpacing(tokens.spacing, 16) }};
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
  border: 3px solid {{ Colors.withAlpha(tokens.ring, 0.5) }};
  outline: 3px solid {{ Colors.withAlpha(tokens.ring, 0.5) }};
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
  background: {{ Colors.withAlpha(tokens.input, 0.8 if is_dark else 0.5) }};
  color: {{ Colors.withAlpha(tokens.muted_foreground, 0.5) }};
  border-color: {{ Colors.withAlpha(tokens.input, 0.5) }};
  placeholder-text-color: {{ Colors.withAlpha(tokens.muted_foreground, 0.5) }};
}

QLineEdit[invalid="true"],
QTextEdit[invalid="true"],
QPlainTextEdit[invalid="true"] {
  color: {{ tokens.destructive }};
  border-color: {{ invalid_border }};
  outline: 3px solid {{ invalid_outline }};
}

/* ============================================================
   QSpinBox and QDoubleSpinBox
   ============================================================ */

QSpinBox,
QDoubleSpinBox {
  background: {{ input_bg }};
  color: {{ tokens.foreground }};
  border: 1px solid {{ tokens.input }};
  outline: none;
  border-radius: {{ Radius.resolveRadius(tokens.radius, "lg") }};
  font-size: {{ Typography.FontSize.SM }};
  placeholder-text-color: {{ tokens.muted_foreground }};
  selection-background-color: {{ tokens.primary }};
  selection-color: {{ tokens.primary_foreground }};
  padding: 0 {{ Scale.resolveSpacing(tokens.spacing, 8) }} 0 {{ Scale.resolveSpacing(tokens.spacing, 2.5) }};
  min-height: {{ Scale.resolveSpacing(tokens.spacing, 8) }};
}

QSpinBox:focus,
QDoubleSpinBox:focus {
  border-color: {{ tokens.ring }};
  outline: 3px solid {{ Colors.withAlpha(tokens.ring, 0.5) }};
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
  background: {{ Colors.withAlpha(tokens.input, 0.8 if is_dark else 0.5) }};
  color: {{ Colors.withAlpha(tokens.muted_foreground, 0.5) }};
  border-color: {{ Colors.withAlpha(tokens.input, 0.5) }};
  placeholder-text-color: {{ Colors.withAlpha(tokens.muted_foreground, 0.5) }};
}

QSpinBox[invalid="true"],
QDoubleSpinBox[invalid="true"] {
  color: {{ tokens.destructive }};
  border-color: {{ invalid_border }};
  outline: 3px solid {{ invalid_outline }};
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
  width: {{ Scale.resolveSpacing(tokens.spacing, 8) }};
  border: none;
  background: transparent;
  border-top-right-radius: {{ Radius.resolveRadius(tokens.radius, "lg") }};
  border-top-left-radius: 0px;
  border-bottom-right-radius: 0px;
  border-bottom-left-radius: 0px;
  subcontrol-position: top right;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
  width: {{ Scale.resolveSpacing(tokens.spacing, 8) }};
  border: none;
  background: transparent;
  border-bottom-right-radius: {{ Radius.resolveRadius(tokens.radius, "lg") }};
  border-top-right-radius: 0px;
  border-top-left-radius: 0px;
  border-bottom-left-radius: 0px;
  subcontrol-position: bottom right;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
  background: {{ tokens.muted }};
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
  background: {{ tokens.accent }};
}

QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled,
QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled {
  background: {{ Colors.withAlpha(tokens.muted, 0.5) }};
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
  width: {{ Scale.resolveSpacing(tokens.spacing, 4) }};
  height: {{ Scale.resolveSpacing(tokens.spacing, 4) }};
  image: url("{{ Icons.getIconUrl("chevron-up", tokens.muted_foreground) }}");
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
  width: {{ Scale.resolveSpacing(tokens.spacing, 4) }};
  height: {{ Scale.resolveSpacing(tokens.spacing, 4) }};
  image: url("{{ Icons.getIconUrl("chevron-down", tokens.muted_foreground) }}");
}

QSpinBox::up-arrow:hover,
QDoubleSpinBox::up-arrow:hover {
  image: url("{{ Icons.getIconUrl("chevron-up", tokens.foreground) }}");
}

QSpinBox::down-arrow:hover,
QDoubleSpinBox::down-arrow:hover {
  image: url("{{ Icons.getIconUrl("chevron-down", tokens.foreground) }}");
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled {
  image: url("{{ Icons.getIconUrl("chevron-up", Colors.withAlpha(tokens.muted_foreground, 0.5)) }}");
}

QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled {
  image: url("{{ Icons.getIconUrl("chevron-down", Colors.withAlpha(tokens.muted_foreground, 0.5)) }}");
}

QSpinBox[invalid="true"]::up-arrow,
QDoubleSpinBox[invalid="true"]::up-arrow {
  image: url("{{ Icons.getIconUrl("chevron-up", tokens.destructive) }}");
}

QSpinBox[invalid="true"]::down-arrow,
QDoubleSpinBox[invalid="true"]::down-arrow {
  image: url("{{ Icons.getIconUrl("chevron-down", tokens.destructive) }}");
}

/* ============================================================
   QProgressBar
   ============================================================ */

{% set progress_bar_height = Scale.resolveSpacing(tokens.spacing, 8) %}

QProgressBar {
    background-color: {{ tokens.muted }};
    border: 0px;
    border-radius: {{ Radius.halveRadius(progress_bar_height) }};
    min-height: {{ Scale.resolveSpacing(tokens.spacing, 1) }};
    max-height: {{ Scale.resolveSpacing(tokens.spacing, 1) }};
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: {{ tokens.primary }};
    border-radius: {{ Radius.halveRadius(progress_bar_height) }};
    margin: 0;
}

QProgressBar[labeled="true"] {
    color: {{ tokens.accent }};
    min-height: {{ Scale.resolveSpacing(tokens.spacing, 4) }};
    max-height: {{ Scale.resolveSpacing(tokens.spacing, 4) }};
    border-radius: {{ Radius.resolveRadius(tokens.radius, "md") }};
}

QProgressBar::chunk[labeled="true"] {
    border-radius: {{ Radius.resolveRadius(tokens.radius, "md") }};
}

QProgressBar:disabled { background-color: {{ Colors.withAlpha(tokens.muted, 0.5) }}; }

QProgressBar::chunk:disabled { background-color: {{ Colors.withAlpha(tokens.primary, 0.5) }}; }

/* ============================================================
   QSlider
   ============================================================ */

{% set groove = Scale.toSpacingInt(tokens.spacing, 1) %}
{% set handle = Scale.toSpacingInt(tokens.spacing, 3) %}
{% set offset = (handle - groove) // 2 %}

QSlider:horizontal { min-height: {{ handle }}px; }
QSlider:vertical { min-width: {{ handle }}px; }

QSlider::groove:horizontal {
  height: {{ groove }}px;
  margin: 0;
  background: {{ tokens.muted }};
  border-radius: {{ Radius.halveRadius(Scale.resolveSpacing(tokens.spacing, 1)) }};
}

QSlider::groove:vertical {
  width: {{ groove }}px;
  margin: 0;
  background: {{ tokens.muted }};
  border-radius: {{ Radius.halveRadius(Scale.resolveSpacing(tokens.spacing, 1)) }};
}

QSlider::handle {
  width: {{ handle }}px;
  height: {{ handle }}px;
  border: 0;
  background: transparent;
  image: url({{ Icons.renderSliderThumb(tokens.primary, tokens.primary, handle) }});
}

QSlider::handle:horizontal { margin: -{{ offset }}px 0; }
QSlider::handle:vertical { margin: 0 -{{ offset }}px; }

QSlider::handle:hover {
  image: url({{ Icons.renderSliderThumb(tokens.primary, tokens.ring, handle) }});
}

QSlider::add-page {
  background: {{ tokens.muted }};
}

QSlider::sub-page {
  background: {{ tokens.primary }};
}

QSlider::handle:disabled {
  image: url({{ Icons.renderSliderThumb(tokens.input, tokens.input, handle) }});
}

QSlider::sub-page:disabled { background: {{ Colors.withAlpha(tokens.input, 0.5) }}; }

/* ============================================================
   QTabWidget
   ============================================================ */

QTabWidget::pane {
    border: none;
}

QTabBar {
    background: {{ tokens.muted }};
    border-radius: {{ Radius.resolveRadius(tokens.radius, "lg") }};
    padding: {{ Scale.resolveSpacing(tokens.spacing, 1) }};
}

QTabBar::tab {
    background: transparent;
    color: {{ tokens.muted_foreground }};
    border: 1px solid transparent;
    border-radius: {{ Radius.resolveRadius(tokens.radius, "md") }};
    margin: {{ Scale.resolveSpacing(tokens.spacing, 0.7) }};
    padding: {{ Scale.resolveSpacing(tokens.spacing, 0.5) }} {{ Scale.resolveSpacing(tokens.spacing, 3) }};
    min-height: {{ Scale.resolveSpacing(tokens.spacing, 7) }};
    font-size: {{ Typography.FontSize.SM }};
}

QTabBar::tab:selected {
    background: {{ tokens.background }};
    color: {{ tokens.foreground }};
    border-color: {{ tokens.muted }};
    font-weight: {{ Typography.FontWeight.BOLD }};
}

QTabBar::tab:hover {
    color: {{ tokens.foreground }};
}

QTabBar::tab:disabled {
    color: {{ Colors.withAlpha(tokens.muted_foreground, 0.5) }};
}

QTabWidget[variant="line"] QTabBar {
    background: transparent;
    border-radius: 0px;
    padding: 0px;
}

QTabWidget[variant="line"] QTabBar::tab {
    background: transparent;
    color: {{ tokens.muted_foreground }};
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    padding: {{ Scale.resolveSpacing(tokens.spacing, 1) }} {{ Scale.resolveSpacing(tokens.spacing, 3) }};
}

QTabWidget[variant="line"] QTabBar::tab:selected {
    background: transparent;
    color: {{ tokens.foreground }};
    border-bottom-color: {{ tokens.foreground }};
}

QTabWidget[variant="line"] QTabBar::tab:hover {
    color: {{ tokens.foreground }};
}

QTabWidget[variant="line"] QTabBar::tab:disabled {
    color: {{ Colors.withAlpha(tokens.muted_foreground, 0.5) }};
}

QTabWidget[variant="line"] QTabBar::tab:left {
    border: none;
    border-right: 2px solid transparent;
}

QTabWidget[variant="line"] QTabBar::tab:left:selected {
    border-right-color: {{ tokens.foreground }};
}

/* ============================================================
   Typography classes
   ============================================================ */

*[class~="h1"] { font-size: 36px; font-weight: 700; }
*[class~="h2"] { font-size: 30px; font-weight: 600; }
*[class~="h3"] { font-size: 24px; font-weight: 600; }
*[class~="h4"] { font-size: 20px; font-weight: 600; }
*[class~="p"] { font-size: 16px; font-weight: 400; }
*[class~="small"] { font-size: 14px; font-weight: 400; }
*[class~="muted"] { color: {{ tokens.muted_foreground }}; }
