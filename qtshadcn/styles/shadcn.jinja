QLineEdit {
  padding: 0 {{ scale.spacing_px(tokens.spacing, 2.5) }};
  min-height: {{ scale.spacing_px(tokens.spacing, 8) }};
}

QTextEdit {
  padding: {{ scale.spacing_px(tokens.spacing, 2) }} {{ scale.spacing_px(tokens.spacing, 2.5) }};
  min-height: {{ scale.spacing_px(tokens.spacing, 16) }};
}

QLineEdit:focus,
QTextEdit:focus {
  border-color: {{ tokens.ring }};
