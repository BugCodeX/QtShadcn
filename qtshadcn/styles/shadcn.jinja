    background-color: {{ tokens.muted }};
    border: 0px;
    border-radius: {{ radius.class_px(tokens.radius, "full") }};
    min-height: {{ scale.spacing_px(tokens.spacing, 1) }};
    max-height: {{ scale.spacing_px(tokens.spacing, 1) }};
