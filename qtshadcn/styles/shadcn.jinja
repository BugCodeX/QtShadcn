/* QtShadcn base stylesheet generated from a native QtShadcn XML theme. */

* {
    color: {{ tokens.foreground }};
    font-family: {{ tokens.font_family }};
    font-size: {{ scale.TEXT_BASE }};
}

QWidget {
    background-color: {{ tokens.background }};
    color: {{ tokens.foreground }};
}

/* ============================================================
   QLabel
   ============================================================ */

QLabel {
    font-size: {{ scale.TEXT_SM }};
    font-weight: {{ scale.FONT_WEIGHT_MEDIUM }};
    line-height: 100%;
    color: {{ tokens.foreground }};
}

QLabel:disabled { color: {{ colors.alpha(tokens.foreground, 0.5) }}; }


/* ============================================================
   QPushButton
   ============================================================ */

QPushButton {
    background-color: {{ tokens.primary }};
    color: {{ tokens.primary_foreground }};
    border: 1px solid transparent;
    outline: none;
    border-radius: {{ radius.class_px(tokens.radius, "lg") }};
    padding-left: {{ scale.spacing_px(tokens.spacing, 2.5) }};
    padding-right: {{ scale.spacing_px(tokens.spacing, 2.5) }};
    min-height: {{ scale.spacing_px(tokens.spacing, 8) }};
    font-size: {{ scale.TEXT_SM }};
    font-weight: {{ scale.FONT_WEIGHT_MEDIUM }};
}

QPushButton:hover {
    background-color: {{ colors.alpha(tokens.primary, 0.8) }};
}

QPushButton:pressed {
    color: {{ tokens.secondary_foreground }};
    background-color: {{ colors.alpha(tokens.primary, 0.8) }};
}

QPushButton:focus {
    background-color: {{ tokens.primary }};
    color: {{ tokens.primary_foreground }};
    border-color: {{ colors.alpha(tokens.ring, 0.5) }};
    outline: none;
}

QPushButton:disabled {
    background-color: {{ colors.alpha(tokens.primary, 0.5) }};
    color: {{ colors.alpha(tokens.primary_foreground, 0.5) }};
    border-color: transparent;
}

QPushButton[invalid="true"]:focus {
    border-color: {{ tokens.destructive }};
    color: {{ tokens.destructive }};
}

QPushButton[variant="outline"] {
    background-color: {{ tokens.background }};
    color: {{ tokens.foreground }};
    border-color: {{ tokens.border }};
}

QPushButton[variant="outline"]:hover,
QPushButton[variant="outline"]:pressed {
    background-color: {{ tokens.muted }};
    color: {{ tokens.foreground }};
}

QPushButton[variant="secondary"] {
    background-color: {{ tokens.secondary }};
    color: {{ tokens.secondary_foreground }};
    border-color: transparent;
}

QPushButton[variant="secondary"]:hover,
QPushButton[variant="secondary"]:pressed {
    background-color: {{ colors.mix(tokens.secondary, tokens.foreground, 0.05) }};
    color: {{ tokens.secondary_foreground }};
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    color: {{ tokens.foreground }};
    border-color: transparent;
}

QPushButton[variant="ghost"]:hover,
QPushButton[variant="ghost"]:pressed {
    background-color: {{ tokens.muted }};
    color: {{ tokens.foreground }};
}

QPushButton[variant="destructive"] {
    background-color: {{ colors.alpha(tokens.destructive, 0.1) }};
    color: {{ tokens.destructive }};
    border-color: transparent;
}

QPushButton[variant="destructive"]:hover,
QPushButton[variant="destructive"]:pressed {
    background-color: {{ colors.alpha(tokens.destructive, 0.2) }};
}

QPushButton[variant="link"] {
    background-color: transparent;
    color: {{ tokens.primary }};
    border-color: transparent;
    padding-left: 0px;
    padding-right: 0px;
    text-decoration: underline;
}

QPushButton[variant="link"]:hover,
QPushButton[variant="link"]:pressed {
    background-color: transparent;
    color: {{ tokens.primary }};
    text-decoration: underline;
}

QPushButton[variant="outline"]:disabled {
    background-color: transparent;
    color: {{ colors.alpha(tokens.foreground, 0.5) }};
    border-color: {{ tokens.border }};
}

QPushButton[variant="ghost"]:disabled,
QPushButton[variant="link"]:disabled {
    border: 0px;
    background-color: transparent;
    color: {{ colors.alpha(tokens.foreground, 0.5) }};
}

QPushButton[size="xs"] {
    border-radius: {{ radius.min_px(tokens.radius, "md", "10px") }};
    padding-left: {{ scale.spacing_px(tokens.spacing, 2) }};
    padding-right: {{ scale.spacing_px(tokens.spacing, 2) }};
    min-height: {{ scale.spacing_px(tokens.spacing, 6) }};
    font-size: {{ scale.TEXT_XS }};
}

QPushButton[size="sm"] {
    border-radius: {{ radius.min_px(tokens.radius, "md", "12px") }};
