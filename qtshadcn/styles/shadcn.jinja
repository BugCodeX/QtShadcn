/* ============================================================
   QSlider
   ============================================================ */

{% set groove = scale.spacing_int(tokens.spacing, 1) %}
{% set handle = scale.spacing_int(tokens.spacing, 3) %}
{% set offset = (handle - groove) // 2 %}

QSlider:horizontal { min-height: {{ handle }}px; }
QSlider:vertical { min-width: {{ handle }}px; }

QSlider::groove:horizontal {
  height: {{ groove }}px;
  margin: 0;
  background: {{ tokens.muted }};
  border-radius: {{ radius.class_px(tokens.radius, "full") }};
}

QSlider::groove:vertical {
  width: {{ groove }}px;
  margin: 0;
  background: {{ tokens.muted }};
  border-radius: {{ radius.class_px(tokens.radius, "full") }};
}

QSlider::handle {
  width: {{ handle }}px;
  height: {{ handle }}px;
  border: 0;
  background: transparent;
  image: url({{ icons.slider_thumb(tokens.primary, tokens.primary, handle) }});
}

QSlider::handle:horizontal { margin: -{{ offset }}px 0; }
QSlider::handle:vertical { margin: 0 -{{ offset }}px; }

QSlider::handle:hover {
  image: url({{ icons.slider_thumb(tokens.primary, tokens.ring, handle) }});
}

QSlider::add-page {
  background: {{ tokens.muted }};
  border-radius: {{ radius.class_px(tokens.radius, "full") }};
}

QSlider::sub-page {
  background: {{ tokens.primary }};
  border-radius: {{ radius.class_px(tokens.radius, "full") }};
}

QSlider::handle:disabled {
  image: url({{ icons.slider_thumb(tokens.input, tokens.input, handle) }});
}

QSlider::sub-page:disabled { background: {{ colors.alpha(tokens.input, 0.5) }}; }

/* ============================================================
   Typography classes
   ============================================================ */

*[class~="h1"] { font-size: 36px; font-weight: 700; }
*[class~="h2"] { font-size: 30px; font-weight: 600; }
*[class~="h3"] { font-size: 24px; font-weight: 600; }
*[class~="h4"] { font-size: 20px; font-weight: 600; }
*[class~="p"] { font-size: 16px; font-weight: 400; }
*[class~="small"] { font-size: 14px; font-weight: 400; }
*[class~="muted"] { color: {{ tokens.muted_foreground }}; }
