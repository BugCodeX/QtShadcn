/* QtShadcn base stylesheet generated from a native QtShadcn XML theme. */

* {
    color: {{ tokens.foreground }};
    font-size: {{ Typography.FontSize.BASE }};
    font-family: "{{ tokens.font_family }}", sans-serif;
}

/* ============================================================
   QWidget
   ============================================================ */

QWidget {
    color: {{ tokens.foreground }};
    background-color: {{ tokens.card }};
    border-radius: {{ Radius.resolveRadius(tokens.radius, "xl") }};
}

QTabWidget > QWidget {
    border: none;
}

/* ============================================================
   QFrame
   ============================================================ */

QFrame {
    color: {{ tokens.foreground }};
    background-color: {{ tokens.card }};
    border: 1px solid {{ tokens.border }};
    border-radius: {{ Radius.resolveRadius(tokens.radius, "xl") }};
}


/* ============================================================
   QLabel
   ============================================================ */

QLabel {
    line-height: 100%;
    font-size: {{ Typography.FontSize.SM }};
    font-weight: {{ Typography.FontWeight.MEDIUM }};
    color: {{ tokens.foreground }};
    border: none;
}

QLabel[invalid="true"] {
    color: {{ tokens.destructive }};
}

QLabel:disabled { color: {{ Colors.withAlpha(tokens.foreground, 0.5) }}; }


/* ============================================================
   QGroupBox
   ============================================================ */

QGroupBox {
  border: 1px solid {{ tokens.border }};
  border-radius: {{ Radius.resolveRadius(tokens.radius, "md") }};
  padding: {{ Scale.resolveSpacing(tokens.spacing, 3) }};
  padding-top: {{ Scale.resolveSpacing(tokens.spacing, 4) }};
  margin-top: {{ Scale.resolveSpacing(tokens.spacing, 3) }};
  font-size: {{ Typography.FontSize.SM }};
  text-transform: uppercase;
}

QGroupBox::title {
  top: 0;
  subcontrol-origin: margin;
  left: {{ Scale.resolveSpacing(tokens.spacing, 3) }};
  padding: 0 {{ Scale.resolveSpacing(tokens.spacing, 1) }};
}

QGroupBox::title:disabled {
  color: {{ Colors.withAlpha(tokens.muted_foreground, 0.5) }};
}

QGroupBox:flat {
  border: none;
  border-radius: 0;
  margin-top: {{ Scale.resolveSpacing(tokens.spacing, 3) }};
  padding-top: {{ Scale.resolveSpacing(tokens.spacing, 4) }};
}

QGroupBox:flat::title {
  top: 0;
  left: 0;
  background: transparent;
  subcontrol-origin: margin;
  padding: 0 {{ Scale.resolveSpacing(tokens.spacing, 1) }} 0 0;
}

QGroupBox:flat::title:disabled {
  color: {{ Colors.withAlpha(tokens.muted_foreground, 0.5) }};
}

QGroupBox::indicator {
  width: {{ Scale.resolveSpacing(tokens.spacing, 4) }};
  height: {{ Scale.resolveSpacing(tokens.spacing, 4) }};
  border: 1px solid {{ tokens.input }};
  border-radius: {{ Radius.resolveRadius(tokens.radius, "sm") }};
