    color: transparent;
}

QProgressBar::chunk {
    background-color: {{ tokens.primary }};
    border-radius: {{ radius.class_px(tokens.radius, "full") }};
    margin: 0;
}

QProgressBar[labeled="true"] {
    min-height: {{ scale.spacing_px(tokens.spacing, 5) }};
