   QLineEdit and QTextEdit
   ============================================================ */

{% set input_bg = colors.alpha(tokens.input, 0.3) if is_dark else "transparent" %}
{% set invalid_border = colors.alpha(tokens.destructive, 0.5) if is_dark else tokens.destructive %}
