/* ============================================================
   QCheckBox
   ============================================================ */

{% set checkbox_bg = colors.alpha(tokens.input, 0.3) if is_dark else "transparent" %}
{% set invalid_border = colors.alpha(tokens.destructive, 0.5) if is_dark else tokens.destructive %}
{% set invalid_outline = colors.alpha(tokens.destructive, 0.4 if is_dark else 0.2) %}

QCheckBox {
  background: transparent;
  color: {{ tokens.foreground }};
  spacing: {{ scale.spacing_px(tokens.spacing, 2) }};
  font-size: {{ scale.TEXT_SM }};
  font-weight: {{ scale.FONT_WEIGHT_MEDIUM }};
}

QCheckBox::indicator {
  width: {{ scale.spacing_px(tokens.spacing, 4) }};
  height: {{ scale.spacing_px(tokens.spacing, 4) }};
  border: 1px solid {{ tokens.input }};
  border-radius: {{ radius.class_px(tokens.radius, "sm") }};
  background: {{ checkbox_bg }};
}

QCheckBox::indicator:hover { border-color: {{ colors.alpha(tokens.ring, 0.5) }}; }

QCheckBox::indicator:checked,
QCheckBox::indicator:indeterminate {
  background: {{ tokens.primary }};
  border-color: {{ tokens.primary }};
}

QCheckBox::indicator:checked {
  image: url("{{ icons.checkbox_check(tokens.primary_foreground) }}");
}

QCheckBox::indicator:indeterminate {
  image: url("{{ icons.checkbox_indeterminate(tokens.primary_foreground) }}");
}

QCheckBox::indicator:disabled {
  background: {{ colors.alpha(tokens.muted, 0.5) }};
  border-color: {{ colors.alpha(tokens.input, 0.5) }};
}

QCheckBox::indicator:checked:disabled,
QCheckBox::indicator:indeterminate:disabled {
  background: {{ colors.alpha(tokens.primary, 0.5) }};
  border-color: {{ colors.alpha(tokens.primary, 0.5) }};
}

QCheckBox:disabled {
  color: {{ colors.alpha(tokens.muted_foreground, 0.5) }};
}

QCheckBox[invalid="true"] {
  color: {{ tokens.destructive }};
}

QCheckBox[invalid="true"]::indicator {
  border-color: {{ invalid_border }};
  outline: 3px solid {{ invalid_outline }};
}

QCheckBox[invalid="true"]::indicator:hover {
  border-color: {{ colors.alpha(tokens.destructive, 0.8) }};
}

QCheckBox[invalid="true"]::indicator:checked,
QCheckBox[invalid="true"]::indicator:indeterminate {
  background: {{ tokens.destructive }};
  border-color: {{ tokens.destructive }};
}

QCheckBox[invalid="true"]::indicator:checked {
  image: url("{{ icons.checkbox_check(tokens.destructive_foreground) }}");
}

QCheckBox[invalid="true"]::indicator:indeterminate {
  image: url("{{ icons.checkbox_indeterminate(tokens.destructive_foreground) }}");
}

